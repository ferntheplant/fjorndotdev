---
import { FileText, BookOpen, Youtube, Code } from "@lucide/astro";
import type { GoodType } from "@/src/lib/good";

export interface Props {
  type: GoodType;
}

const { type } = Astro.props;

const iconMap: Record<GoodType, typeof FileText> = {
  article: FileText,
  book: BookOpen,
  youtube: Youtube,
  code: Code,
};

const IconComponent = iconMap[type];
---

<IconComponent class="stroke-primary" />
