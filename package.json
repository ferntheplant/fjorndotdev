{
  "name": "@fjorndotdev/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "sherif && typos && vp check && vp run -r test && vp run -r build && vp exec fallow",
    "prepare": "node scripts/link-agents.ts && effect-tsgo patch --no-typescript --oxlint && vp config && vp run --filter @fjorndotdev/site sync:types"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/tsgo": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "fallow": "catalog:",
    "sherif": "catalog:",
    "taze": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "sherif": {
    "failOnWarnings": true,
    "ignoreRule": [
      "non-existant-packages"
    ]
  }
}
